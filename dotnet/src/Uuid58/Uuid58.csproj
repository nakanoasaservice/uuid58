<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 covers .NET Framework 4.6.1+, .NET Core 2.0+, .NET 5+, Unity, and Xamarin. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Uuid58</AssemblyName>
    <RootNamespace>NakanoAsAService.Uuid58</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>

    <!-- NuGet package -->
    <PackageId>Uuid58</PackageId>
    <Version>0.1.0</Version>
    <Authors>Nakano as a Service</Authors>
    <Description>Encode UUIDs (Guid) as fixed-length, order-preserving 22-character Base58 strings. Implements the uuid58 specification.</Description>
    <PackageTags>uuid;guid;base58;uuid58;encoding;short-id</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://nakanoasaservice.github.io/uuid58/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nakanoasaservice/uuid58</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
