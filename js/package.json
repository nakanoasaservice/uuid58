{
  "name": "@nakanoaas/uuid58",
  "version": "2.0.2",
  "description": "Shorten UUIDs to 22-character Base58 strings, and back. URL-safe, order-preserving, and identical across languages under a stable, well-tested spec. Tiny and zero-dependency.",
  "keywords": [
    "base58",
    "encoding",
    "short-id",
    "short-uuid",
    "shorten-uuid",
    "sortable",
    "url-safe",
    "uuid",
    "uuid58",
    "uuidv7"
  ],
  "homepage": "https://nakanoasaservice.github.io/uuid58/",
  "bugs": {
    "url": "https://github.com/nakanoasaservice/uuid58/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nakanoasaservice/uuid58.git",
    "directory": "js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test run",
    "bench": "vp pack && vp test bench --run --reporter=default bench/uuid58",
    "bench:compare": "vp pack && vp test bench --run --reporter=default bench/compare",
    "bench:baseline": "sh bench/save-baseline.sh",
    "jsr:dry-run": "vp pack && jsr publish --dry-run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "bs58": "6.0.0",
    "jsr": "^0.14.3",
    "short-uuid": "6.0.3",
    "typescript": "^7.0.2",
    "vite-plus": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.5"
}
