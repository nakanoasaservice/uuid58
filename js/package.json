{
  "name": "@nakanoaas/uuid58",
  "version": "2.0.1",
  "description": "A tiny, zero-dependency library that encodes UUIDs as fixed 22-character, order-preserving Base58 strings, and back.",
  "keywords": [
    "uuid",
    "base58",
    "uuid58",
    "short-uuid",
    "short-id",
    "uuidv7",
    "encoding",
    "id"
  ],
  "homepage": "https://nakanoasaservice.github.io/uuid58/",
  "bugs": {
    "url": "https://github.com/nakanoasaservice/uuid58/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nakanoasaservice/uuid58.git",
    "directory": "js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test run",
    "bench": "vp pack && vp test bench --run --reporter=default",
    "bench:baseline": "sh bench/save-baseline.sh",
    "jsr:dry-run": "vp pack && jsr publish --dry-run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsr": "^0.14.3",
    "typescript": "^7.0.2",
    "vite-plus": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.5"
}
